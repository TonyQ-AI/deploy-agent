@echo off
rem <PROJECT> restart (idempotent) - customize for each project
rem
rem CRITICAL RULES (real incidents 2026-08-26 job-ai-efficiency-generator-v2):
rem   1) THIS FILE MUST STAY PURE ASCII - UTF-8 Chinese comments get mangled
rem      by cmd.exe (GBK codepage) and break the whole batch parse,
rem      so kill never runs and the old process stays forever.
rem   2) watcher runs this script as SYSTEM; SYSTEM PATH has NO node,
rem      so use the FULL node path (bare "node" fails silently,
rem      new process never starts, service keeps running old code).
rem   3) Kill via netstat+taskkill (Get-NetTCPConnection returns empty
rem      under SYSTEM and cannot kill).
rem
rem Kill port listener (adjust <PORT>):
rem   for /f "tokens=5" %%p in ('netstat -ano ^| findstr /R ":<PORT> " ^| findstr /R "LISTENING"') do taskkill /F /PID %%p

taskkill /F /IM <YOUR_PROCESS>.exe > nul 2>&1
timeout /t 2 /nobreak > nul
start "" "C:\Program Files\nodejs\node.exe" <YOUR_START_ARGS>
